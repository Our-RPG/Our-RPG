# Lua scripting layer — the embedded wasmoon (Lua 5.4) VM that owns all authored
# game content (quests, NPC dialogue, event triggers, item behaviour, encounters,
# cutscenes). wasmoon itself (libs/lua/wasmoon.js) is a vendored UMD global loaded
# via its own <script> tag in index.html (see the VENDOR set in tools/build.mjs).
# Order matters: modal/coro (no deps) -> host bridge -> engine -> generated
# sources (LUA_PRELUDE + LUA_SRC) -> boot (kicks off async init).
js/lua/lua-modal.js
js/lua/lua-coro.js
js/lua/lua-host.js
js/lua/lua-engine.js
js/lua/lua-src-gen.js
js/lua/lua-boot.js
js/gameplay/tutorial.js
js/gameplay/daynight.js
# in-settlement roster button + overlay; reads currentSettlement (daynight),
# world.npcs, findPath (pathing), hoverLabel/doTarget (input), SHOP_TYPES (market)
js/gameplay/townfolk-ui.js
js/gameplay/biomeatmos.js
js/gameplay/weather.js
js/gameplay/cheats.js
js/gameplay/armour-overlay.js
js/gameplay/wardrobe-parts.js
