js/gameplay/pulse.js
# Phase-1 server layer (js/net/): all of it no-ops unless the build sets
# TAIAO_SERVER_URL. Order: api core first; actionlog wraps the choke points
# (after pulse.js so both wrap chains stack); UI last.
js/net/serverapi.js
# the two hard gates (account modal + reconnect curtain) — after serverapi so
# AccountGate can use Server; consumed by tutorial.js and main.js at runtime.
js/net/gate-ui.js
js/net/telemetry.js
js/net/actionlog.js
js/net/savesync.js
# pre-boot landing chooser — after serverapi/savesync (uses Server.login/
# passkeyLogin + SaveSync.restore), before main.js (awaited at the top of
# init(), see js/main.js and js/net/gate-ui.js's header comment).
js/net/boot-chooser.js
js/net/worksync.js
# Phase-2 shared-world layer: region mutation ledger, shop stock ledger,
# server-issued seeds. Same rule: inert without SERVER_URL + a login.
js/net/regionsync.js
js/net/shopsync.js
js/net/seedroll.js
# Phase-3 live presence: real-time zone WebSocket (remote players, deeds,
# instant mutations) + the chat/trade UI it gates. livesync wraps killMonster/
# ShopSync/RegionSync, so it must follow combat + the Phase-2 layer.
js/net/livesync.js
# shared monsters & NPCs: proximity-authority entity sync. After livesync (its
# socket) and after combat/monsters (it wraps addSplat + killMonster).
js/net/entsync.js
js/net/live-ui.js
# right-click player actions: follow / give / feed (wraps walkTo + setGoal)
js/net/player-actions.js
# Phase-4 global presence: the cross-zone hub socket (online roster + DMs) and
# its UI. hubsync must precede social-ui (which guards on `typeof Hub`).
js/net/hubsync.js
js/net/social-ui.js
# NPC-engine connectivity pill: between online-top (8px) and townfolk-top
# (now 72px). After social-ui (shares its styling convention) and
# npc-engine-client.js (gameplay/, loaded earlier) for npcEngineAvailable().
js/net/npc-engine-ui.js
js/net/account-panel.js
js/gameplay/koha.js
js/gameplay/goals-arc.js
js/gameplay/eggs.js
js/gameplay/postcard.js
# Studio "play with my changes" preview overlay — inert unless the player set
# the localStorage flag in the studio. Must come after assets.js (ICON_OVERRIDE)
# and data.js (ITEMS), before main.js.
js/main/proposal-overlay.js
js/main.js
