# ── OS / editor cruft ──────────────────────────────────────────────
.DS_Store
**/.DS_Store
Thumbs.db

# ── Python build tooling ───────────────────────────────────────────
__pycache__/
*.pyc
*.pyo

# ── Moved to ../RPG-archive (parked / dev-only, never shipped) ──────
/backup/
/tools/npc_brain/
/tools/npc_training/
/assets/venv_app/
/assets/sprite_review_tool/
/item_pick.json

# ── Dropped LC3D voxel subsystem (archived; not in the shipped bundle) ──
/js/legacy3d.js
/js/lc-bestiary.js
/js/sprites/lc-cache-data.js
/libs/legacy-engine.js

# ── Assets: the game ships ONLY sheets/ + sfx/ (+ provenance licenses). ──
# All dev-only sprite-pipeline source has been moved to ../RPG-archive/assets/.
# This ignore keeps any stray regenerated source out of the tracked tree.
/assets/*
!/assets/sfx/
!/assets/sheets/
!/assets/LICENSE-*.txt

# Music: the Bifrost theme is CC BY 4.0 (Kevin MacLeod — attribution in
# assets/music/CREDITS.txt, BY is compatible with the CC BY-SA grant) and
# small, so it ships in-tree. The exploration layer is generated live
# (music.js) — no audio files to ship.
!/assets/music/

# Ambience loop beds are ORIGINAL synthesized audio (tools/make_ambience.py
# shaped noise — no third-party source), tiny (~640K), CC BY-SA like the
# rest of the assets: they ship in-tree.
!/assets/ambience/

# Birdsong: the CC BY-NC-SA recordings themselves stay OUT (that license is
# incompatible with this repo's CC BY-SA asset grant, and NC forbids resale —
# see README "Credits"); the per-clip attribution text is small, plain text,
# and is exactly what an NC license requires whoever distributes it to carry,
# so it ships even though the audio it describes doesn't. Regenerated by
# tools/fetch_birdsong.py whenever the bank is refetched. The clips are
# distributed from the companion Taiao-cdn repo (publish_cdn_assets.sh) and
# sw.js streams them in lazily, so clones still get singing skies.
!/assets/birdsong/
/assets/birdsong/*.ogg

# Large offline source sprite libraries (dev-only, not fetched at runtime)
/tilesheets/
/tiny-creatures/

# Node build tooling (added during optimization phase)
/node_modules/

# Secrets — never commit
/api.txt

# ── NPC dialogue pipeline: scripts are tracked, corpora/models are not ──
# (bank + embeddings + in-browser ONNX runtime total ~400MB. The runtime
# set is published to the companion Taiao-cdn repo — see
# tools/publish_cdn_assets.sh — and sw.js lazily streams it in per file,
# so clones get full semantic chat without the repo carrying the weight;
# fully offline, npc-chat.js's starter pool still answers.)
/tools/npc_dialogue/bank.jsonl
/tools/npc_dialogue/bank.jsonl.pre-dedup
/tools/npc_dialogue/generated/
/libs/npcml/

# Phase-1 server (server/): local dev state and secrets only — src, schema
# and configs ARE tracked (the server being open is part of the trust story)
/server/node_modules/
/server/.wrangler/
/server/.dev.vars*

# generated web-build zip (tools/build_web_zip.sh) — a build artifact, not source
/dist/taiao-web.zip

# web-distribution zips (tools/build_web_zip.sh output)
dist/taiao-web*.zip

# generated itch-page assets (cover/GIF shot from the live game) — artifacts, not source
/dist/itch-page/

# telemetry analytics dumps (player data — repo is public, never commit)
analytics/

# Lua source bundle — generated from scripts/**/*.lua by tools/build.mjs
js/lua/lua-src-gen.js

# Assembled Workshop site (studio/tools/build_site.mjs) — deploy artifact, not source.
/studio/dist/

# Deep-zoom zone tile pyramids (~650MB/zone) — never committed, never shipped
# inline; see studio/DEPLOY.md "Deep-zoom zone tiles are excluded by default".
/studio/assets/zones/*_tiles/

# Session scratch directory — temp/working files, not source.
/scratchpad/
