# Cloudflare Pages header rules (our-rpg.com).
#
# The shell files below must REVALIDATE on every use (cheap conditional GETs —
# etag 304s when unchanged). Without this, Pages' default max-age=14400 let a
# browser serve a four-hour-stale bundle.js from its HTTP cache *through* the
# service worker's network-first fetch — which is how the torn v29 bundle
# stayed pinned on clients after the fixed redeploy (2026-10-02 vista-map
# incident). The SW's own Cache Storage still makes loads instant; this only
# governs real network fetches.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/play
  Cache-Control: no-cache
/play.html
  Cache-Control: no-cache
/home
  Cache-Control: no-cache
/home.html
  Cache-Control: no-cache
/koha
  Cache-Control: no-cache
/koha.html
  Cache-Control: no-cache
/dist/*
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/css/*
  Cache-Control: no-cache

# ── Security headers (global) ───────────────────────────────────────────────
# Baseline protections for a site that renders user-generated HTML + chat.
# The CSP ships Report-Only first: a _headers CSP can't be exercised by the
# local python dev server, so enforcing it blind could break the live game.
# AFTER deploying to a Pages preview, open the game AND the Workshop, confirm
# the DevTools console shows no "Content-Security-Policy" violation reports,
# then rename the header below from `Content-Security-Policy-Report-Only` to
# `Content-Security-Policy` to enforce it.
# connect-src is scoped to exactly what the client uses: same-origin API +
# wss sockets (live/hub), the Workshop BYO endpoints (Anthropic/PixelLab),
# Turnstile, and the raw.githubusercontent CDN asset fallback (sw.js).
# microphone/fullscreen/autoplay are intentionally NOT disabled (voice chant
# casting + fullscreen + game audio depend on them).
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), camera=(), payment=(), usb=(), midi=(), magnetometer=(), gyroscope=(), accelerometer=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://raw.githubusercontent.com; media-src 'self' data: blob: https://raw.githubusercontent.com; font-src 'self' data:; connect-src 'self' wss://our-rpg.com https://api.anthropic.com https://api.pixellab.ai https://challenges.cloudflare.com https://raw.githubusercontent.com; frame-src https://challenges.cloudflare.com; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'
